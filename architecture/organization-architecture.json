  "cards": [
    { "dot": "cyan", "title": "Usage", "items": ["Developers drive the `templetry` CLI directly or through the desktop app; AI agents drive it over `templetry-mcp`", "The desktop app imports the engine as a Go library — no IPC, no sidecar", "Every path ends the same way: a repo created or updated on GitHub, GitLab, Gitea/Forgejo, or any self-hosted forge (BYOR)"] },
    { "dot": "emerald", "title": "Content pipeline", "items": ["`catalog`'s registry.json is the single source of truth for where every form and piece actually lives", "11 parent repos hold the forms themselves; `pieces` holds units adopted after creation, independent of any one form's lifecycle"] },
    { "dot": "amber", "title": "Governance & distribution", "items": ["Renovate proposes an engine-version bump; once merged into `.github`'s setup-templetry action, every parent's CI re-verifies all its forms against it", "Homebrew tap and Scoop bucket regenerate their install manifests from the engine's own GitHub Release artifacts — packaging trails the engine automatically", "`renovate-config`'s preset is extended by every repository in the org, not drawn as an edge to every node to keep the diagram readable"] },
